# Copy file này thành .env rồi điền giá trị thật.
# .env bị .gitignore chặn nên mật khẩu không lên GitHub; file .example này thì được commit
# để người khác biết cần khai báo những biến nào.

# Postgres (docker-compose dùng các biến này để tạo database lần đầu)
POSTGRES_DB=camerashop
POSTGRES_USER=camerashop
POSTGRES_PASSWORD=doi_mat_khau_o_day
POSTGRES_PORT=5432

# Chuỗi bí mật để ký vé đăng nhập (JWT), ít nhất 32 ký tự. Bỏ trống khi code ở máy thì backend dùng giá trị mặc định;
# deploy thật BẮT BUỘC đặt chuỗi ngẫu nhiên riêng.
JWT_SECRET=
