# Copy file này thành .env rồi điền giá trị thật.
# .env bị .gitignore chặn nên mật khẩu không lên GitHub; file .example này thì được commit
# để người khác biết cần khai báo những biến nào.

# Postgres (docker-compose dùng các biến này để tạo database lần đầu)
POSTGRES_DB=camerashop
POSTGRES_USER=camerashop
POSTGRES_PASSWORD=doi_mat_khau_o_day
POSTGRES_PORT=5432

# Chuỗi bí mật để ký vé đăng nhập (JWT), ít nhất 32 ký tự.
# Code ở máy: ĐỂ NGUYÊN dòng dưới là ghi chú (có dấu #) -> backend dùng giá trị dự phòng trong application.yaml.
# Đừng ghi "JWT_SECRET=" để trống: backend sẽ nhận chuỗi rỗng và không khởi động được.
# Deploy thật: BẮT BUỘC bỏ dấu # và đặt chuỗi ngẫu nhiên riêng.
# JWT_SECRET=doi-thanh-chuoi-ngau-nhien-it-nhat-32-ky-tu
# Vé đăng nhập sống bao lâu (mặc định 24h). Vd 2h, 30m.
# JWT_EXPIRATION=24h

# Gửi mail. Code ở máy: KHÔNG cần khai báo gì -> mặc định gửi vào Mailpit (docker compose up -d, xem ở localhost:8025).
# Deploy gửi thật bằng Gmail (cần "Mật khẩu ứng dụng" của Google, KHÔNG phải mật khẩu Gmail thường):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=hopthucuashop@gmail.com
# MAIL_PASSWORD=mat-khau-ung-dung-16-ky-tu
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# MAIL_FROM=CameraShop <hopthucuashop@gmail.com>
# FRONTEND_URL=https://ten-mien-frontend-that

# Thanh toán VNPay (môi trường TEST). Đăng ký: https://sandbox.vnpayment.vn/devreg/ -> mail gửi 2 giá trị này.
# VNPAY_TMN_CODE=ma-website-8-ky-tu
# VNPAY_HASH_SECRET=chuoi-bi-mat-de-ky-link-thanh-toan

# Chat bot tư vấn (Google Gemini, gói miễn phí). Lấy key: https://aistudio.google.com/apikey -> "Create API key".
# Không đặt -> web vẫn chạy, chỉ chat bot báo "chưa được cấu hình".
# GEMINI_API_KEY=key-cua-ban
# Đổi model không cần sửa code (xem danh sách model miễn phí trong AI Studio):
# GEMINI_MODEL=gemini-3.5-flash-lite

# ===== Chỉ dùng khi DEPLOY (máy dev để trống) =====
# Database Neon: chuỗi JDBC, vd jdbc:postgresql://<host>/<db>?sslmode=require  (+ POSTGRES_USER / POSTGRES_PASSWORD)
# DB_URL=
# Kho ảnh Cloudinary (cloudinary.com -> Dashboard -> API Keys). IMAGE_STORAGE=cloudinary để ảnh admin tải lên lưu trên mây.
# IMAGE_STORAGE=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Tắt in câu SQL ra log
# SQL_LOG_LEVEL=info
